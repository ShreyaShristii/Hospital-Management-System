# Client Environment Variables
# Copy this file to .env and fill in with your API URL
# NEVER commit .env file to version control!
# NOTE: Only public environment variables should be here
# Razorpay Key ID can be public, but it's better to fetch it from the API

VITE_API_URL=https://api.your-domain.com/api

# Public Razorpay Key (can also be fetched from backend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
